# Python bytecode and test/tool caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Node dependencies and generated frontend bundles
frontend/node_modules/
frontend/dist/

# Environment files (keep the non-secret template)
.env
.env.*
!.env.example

# Operating system and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
*.log

# Local Overpass cache is transient; allow explicitly curated seed JSON fixtures.
data/cache/*
!data/cache/seed/
data/cache/seed/*
!data/cache/seed/*.json
